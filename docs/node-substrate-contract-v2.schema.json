{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimnir.gille.ai/contracts/node-substrate/v2/schema.json",
  "title": "Grimnir node/substrate decision records v2",
  "description": "Version 2 adds armv7l as an explicit node and workload architecture. Other record kinds remain v1 until separately versioned.",
  "oneOf": [{ "$ref": "#/$defs/node-capability" }, { "$ref": "#/$defs/workload-requirement" }],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" },
    "utc": { "type": "string", "format": "date-time" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "extension": { "type": "object", "additionalProperties": false, "required": ["id", "version", "decision_effect"], "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" }, "version": { "type": "string", "pattern": "^v[1-9][0-9]*$" }, "decision_effect": { "enum": ["informational"] } } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["evidence_id", "producer", "observed_at", "digest"], "properties": { "evidence_id": { "$ref": "#/$defs/id" }, "producer": { "const": "brokkr" }, "observed_at": { "$ref": "#/$defs/utc" }, "digest": { "$ref": "#/$defs/digest" } } },
    "hook": { "type": "object", "additionalProperties": false, "required": ["name", "mode", "contract_versions", "deadline_seconds", "idempotency_required"], "properties": { "name": { "enum": ["preflight", "drain", "verify", "rollback", "compensate"] }, "mode": { "enum": ["read_only", "mutating"] }, "contract_versions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "const": "v1" } }, "deadline_seconds": { "type": "integer", "minimum": 1 }, "idempotency_required": { "const": true }, "compensation_hook": { "enum": ["rollback", "compensate"] } } },
    "node-capability": { "type": "object", "additionalProperties": false, "required": ["kind", "schema_version", "node_id", "observed_at", "valid_until", "evidence", "capability_status", "architecture", "resources", "uptime_class", "network_capabilities", "logical_storage", "service_manager", "deployment_mechanisms", "health_reporting", "extensions"], "properties": { "kind": { "const": "node-capability" }, "schema_version": { "const": "v2" }, "node_id": { "$ref": "#/$defs/id" }, "observed_at": { "$ref": "#/$defs/utc" }, "valid_until": { "$ref": "#/$defs/utc" }, "evidence": { "$ref": "#/$defs/evidence" }, "capability_status": { "enum": ["known", "unknown", "not_applicable"] }, "architecture": { "enum": ["arm64", "armv7l", "x86_64", "unknown", "not_applicable"] }, "resources": { "type": "object", "additionalProperties": false, "required": ["cpu_cores", "memory_mib"], "properties": { "cpu_cores": { "type": "integer", "minimum": 1 }, "memory_mib": { "type": "integer", "minimum": 1 } } }, "uptime_class": { "enum": ["always_on", "best_effort", "unknown", "not_applicable"] }, "network_capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["wired", "wifi", "tailnet", "unknown", "not_applicable"] } }, "logical_storage": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["class", "available_mib", "status"], "properties": { "class": { "enum": ["local_ssd", "external_ssd", "network_share", "unknown", "not_applicable"] }, "available_mib": { "type": "integer", "minimum": 0 }, "status": { "enum": ["known", "unknown", "not_applicable"] } } } }, "service_manager": { "enum": ["systemd", "launchd", "unknown", "not_applicable"] }, "deployment_mechanisms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["guarded_deploy", "systemd", "manual_operator", "unknown", "not_applicable"] } }, "health_reporting": { "enum": ["supported", "unsupported", "unknown", "not_applicable"] }, "extensions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/extension" } } } },
    "workload-requirement": { "type": "object", "additionalProperties": false, "required": ["kind", "schema_version", "workload_id", "supported_architectures", "persistent_data", "ports", "units", "timers", "secrets_boundary", "dependencies", "backup_restore", "health", "hooks", "extensions"], "properties": { "kind": { "const": "workload-requirement" }, "schema_version": { "const": "v2" }, "workload_id": { "$ref": "#/$defs/id" }, "supported_architectures": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["arm64", "armv7l", "x86_64"] } }, "persistent_data": { "enum": ["none", "required", "unknown", "not_applicable"] }, "ports": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } }, "units": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9@._-]+$" } }, "timers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9@._-]+$" } }, "secrets_boundary": { "enum": ["owner_overlay", "none", "unknown", "not_applicable"] }, "dependencies": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "backup_restore": { "enum": ["required", "not_required", "unknown", "not_applicable"] }, "health": { "enum": ["component_hook", "external_probe", "unknown", "not_applicable"] }, "hooks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hook" } }, "extensions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/extension" } } } }
  }
}
