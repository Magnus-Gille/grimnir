{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimnir.local/schemas/autonomous-mutation-journal-v1",
  "title": "Grimnir autonomous mutation journal v1",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "schema_version", "entry_id", "mutation_id", "sequence", "recorded_at", "phase", "outcome", "constitution_digest", "baseline_digest", "postconditions_digest", "deadline", "recovery", "previous_receipt_digest", "receipt_digest", "content_refs", "extensions"],
  "properties": {
    "kind": { "const": "autonomous-mutation-journal-entry" }, "schema_version": { "const": "v1" },
    "entry_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" }, "mutation_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" }, "sequence": { "type": "integer", "minimum": 1 }, "recorded_at": { "type": "string", "format": "date-time" },
    "phase": { "enum": ["prepare", "apply", "verify", "watch", "commit", "revert", "recover", "quarantine", "disarm"] }, "outcome": { "enum": ["prepared", "applied", "verified", "watching", "committed", "reverted", "recovered", "quarantined", "unknown", "terminally-blocked", "disarmed"] },
    "constitution_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "baseline_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "postconditions_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "deadline": { "type": "string", "format": "date-time" },
    "recovery": { "type": "object", "additionalProperties": false, "required": ["class", "worker_identity", "disarms_after_action"], "properties": { "class": { "enum": ["R-exact", "R-forward"] }, "worker_identity": { "type": "string" }, "disarms_after_action": { "const": true } } },
    "previous_receipt_digest": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }] }, "receipt_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "content_refs": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9:-]{2,120}$" } }, "extensions": { "type": "array", "maxItems": 0 }
  }
}
