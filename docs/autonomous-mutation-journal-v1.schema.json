{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimnir.gille.ai/contracts/autonomous-mutation-journal/v1/schema.json",
  "title": "Grimnir autonomous mutation journal v1",
  "description": "One authoritative, content-blind, append-only domain journal. Semantic chain, transition, identity, deadline, canary, recovery, quarantine, and digest checks are normative in tests/scripts/validate-autonomy-contract.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "journal_id", "domain", "constitution_digest", "entries", "extensions"],
  "properties": {
    "kind": { "const": "autonomous-mutation-journal" }, "schema_version": { "const": "v1" }, "journal_id": { "$ref": "#/$defs/id" },
    "domain": { "enum": ["routing", "no-reboot-security-bugfix-maintenance"] }, "constitution_digest": { "$ref": "#/$defs/digest" },
    "entries": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/entry" } }, "extensions": { "type": "array", "maxItems": 0 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" }, "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "utc": { "type": "string", "format": "date-time" },
    "opaque-ref": { "type": "string", "pattern": "^ref:[a-z][a-z0-9-]{2,120}$" },
    "recovery": { "type": "object", "additionalProperties": false, "required": ["class", "worker_identity", "descriptor_digest", "disarms_after_action"], "properties": { "class": { "enum": ["R-exact", "R-forward"] }, "worker_identity": { "$ref": "#/$defs/id" }, "descriptor_digest": { "$ref": "#/$defs/digest" }, "disarms_after_action": { "const": true } } },
    "canary": { "type": "object", "additionalProperties": false, "required": ["scope_digest", "target_count", "watch_deadline"], "properties": { "scope_digest": { "$ref": "#/$defs/digest" }, "target_count": { "type": "integer", "minimum": 1, "maximum": 1 }, "watch_deadline": { "$ref": "#/$defs/utc" } } },
    "quarantine": { "type": "object", "additionalProperties": false, "required": ["state", "reason_digest"], "properties": { "state": { "enum": ["not-applicable", "active", "cleared-by-new-evidence"] }, "reason_digest": { "$ref": "#/$defs/digest" } } },
    "entry": { "type": "object", "additionalProperties": false, "required": ["entry_id", "mutation_id", "sequence", "recorded_at", "phase", "outcome", "attempt_id", "idempotency_key", "executor_identity", "risk_scope", "baseline_digest", "postconditions_digest", "deadline", "canary", "recovery", "quarantine", "previous_receipt_digest", "receipt_digest", "content_refs"], "properties": {
      "entry_id": { "$ref": "#/$defs/id" }, "mutation_id": { "$ref": "#/$defs/id" }, "sequence": { "type": "integer", "minimum": 1 }, "recorded_at": { "$ref": "#/$defs/utc" },
      "phase": { "enum": ["prepare", "apply", "verify", "watch", "commit", "unknown", "recover", "quarantine", "disarm"] }, "outcome": { "enum": ["prepared", "applied", "verified", "watching", "committed", "unknown", "recovered", "quarantined", "disarmed", "terminally-blocked"] },
      "attempt_id": { "$ref": "#/$defs/id" }, "idempotency_key": { "$ref": "#/$defs/id" }, "executor_identity": { "$ref": "#/$defs/id" }, "risk_scope": { "$ref": "#/$defs/id" }, "baseline_digest": { "$ref": "#/$defs/digest" }, "postconditions_digest": { "$ref": "#/$defs/digest" }, "deadline": { "$ref": "#/$defs/utc" }, "canary": { "$ref": "#/$defs/canary" }, "recovery": { "$ref": "#/$defs/recovery" }, "quarantine": { "$ref": "#/$defs/quarantine" },
      "previous_receipt_digest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] }, "receipt_digest": { "$ref": "#/$defs/digest" }, "content_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/opaque-ref" } }
    } }
  }
}
