{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimnir.local/schemas/autonomy-constitution-v1",
  "title": "Grimnir autonomy constitution v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "constitution_id", "issued_at", "promotion_mode", "protected_lanes", "autonomous_classes", "required_identities", "required_postconditions", "fault_injection_requirements", "constitution_digest", "extensions"],
  "properties": {
    "kind": { "const": "autonomy-constitution" }, "schema_version": { "const": "v1" },
    "constitution_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" }, "issued_at": { "type": "string", "format": "date-time" },
    "promotion_mode": { "enum": ["mechanical"] }, "protected_lanes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "autonomous_classes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["routing", "no-reboot-security-bugfix-maintenance"] } },
    "required_identities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "required_postconditions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "fault_injection_requirements": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "constitution_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "extensions": { "type": "array", "maxItems": 0 }
  }
}
