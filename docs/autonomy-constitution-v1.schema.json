{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimnir.gille.ai/contracts/autonomy-constitution/v1/schema.json",
  "title": "Grimnir autonomy constitution v1",
  "description": "Closed, digest-bound constitutional floor for future Level 4 and Level 5 mechanical promotion. It is a contract only; W0 is disarmed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "constitution_id", "issued_at", "promotion_mode", "protected_lanes", "safety_floors", "autonomous_classes", "constitution_digest", "extensions"],
  "properties": {
    "kind": { "const": "autonomy-constitution" },
    "schema_version": { "const": "v1" },
    "constitution_id": { "$ref": "#/$defs/id" },
    "issued_at": { "$ref": "#/$defs/utc" },
    "promotion_mode": { "const": "mechanical-for-covered-classes-only" },
    "protected_lanes": { "type": "array", "minItems": 10, "uniqueItems": true, "items": { "enum": ["credentials-and-auth", "owner-policy", "constitution-and-safety-gates", "deployments-and-code", "privacy-retention-and-erasure", "firmware", "remote-recovery", "model-weight-training", "irreversible-external-actions", "package-downgrade"] } },
    "safety_floors": { "$ref": "#/$defs/safety-floors" },
    "autonomous_classes": { "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": { "oneOf": [{ "$ref": "#/$defs/micro-routing" }, { "$ref": "#/$defs/macro-routing" }, { "$ref": "#/$defs/prompt" }, { "$ref": "#/$defs/harness" }, { "$ref": "#/$defs/tool-policy" }, { "$ref": "#/$defs/served-model-roster" }, { "$ref": "#/$defs/maintenance" }] } },
    "constitution_digest": { "$ref": "#/$defs/digest" },
    "extensions": { "type": "array", "maxItems": 0 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" },
    "opaque-id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,120}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "utc": { "type": "string", "format": "date-time" },
    "identities": { "type": "object", "additionalProperties": false, "required": ["owner", "controller", "watchdog", "kill_switch", "recovery_worker"], "properties": { "owner": { "$ref": "#/$defs/opaque-id" }, "controller": { "$ref": "#/$defs/opaque-id" }, "watchdog": { "$ref": "#/$defs/opaque-id" }, "kill_switch": { "$ref": "#/$defs/opaque-id" }, "recovery_worker": { "$ref": "#/$defs/opaque-id" } } },
    "postconditions": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "enum": ["verifier-passes", "canary-watch-complete", "controller-disarm-confirmed", "baseline-digest-restored", "safe-state-verified", "micro-route-readback-matches-candidate", "macro-route-readback-matches-candidate", "prompt-config-readback-matches-candidate", "harness-config-readback-matches-candidate", "tool-policy-readback-matches-candidate", "served-model-roster-readback-matches-candidate", "maintenance-safe-state-readback"] } },
    "fault-injection": { "type": "array", "minItems": 5, "uniqueItems": true, "items": { "enum": ["executor-interruption", "observer-cannot-actuate", "recovery-path-proven", "stale-evidence-rejected", "chain-tamper-rejected", "canary-breach-quarantines", "late-mutation-rejected", "kill-switch-rejected"] } },
    "bounds": { "type": "object", "additionalProperties": false, "required": ["max_concurrent_targets", "canary_only_until_armed_fleet", "deadline_seconds", "watch_seconds", "max_attempts"], "properties": { "max_concurrent_targets": { "type": "integer", "minimum": 1, "maximum": 1 }, "canary_only_until_armed_fleet": { "const": true }, "deadline_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 }, "watch_seconds": { "type": "integer", "minimum": 1, "maximum": 604800 }, "max_attempts": { "type": "integer", "minimum": 1, "maximum": 1 } } },
    "safety-floors": { "type": "object", "additionalProperties": false, "required": ["fail_closed", "kill_switch", "fresh_evidence", "unique_identity", "content_blind_journal", "observer_cannot_actuate", "unknown_disarms", "controller_disarm_separate", "protected_lanes_never_promote"], "properties": { "fail_closed": { "const": true }, "kill_switch": { "const": true }, "fresh_evidence": { "const": true }, "unique_identity": { "const": true }, "content_blind_journal": { "const": true }, "observer_cannot_actuate": { "const": true }, "unknown_disarms": { "const": true }, "controller_disarm_separate": { "const": true }, "protected_lanes_never_promote": { "const": true } } },
    "class-common": { "type": "object", "additionalProperties": false, "required": ["class", "level", "owner", "admission", "recovery_class", "bounds", "identities", "required_postconditions", "fault_injection_requirements"], "properties": { "class": { "type": "string" }, "level": { "enum": ["L4", "L5"] }, "owner": { "enum": ["hugin", "gille-inference", "brokkr"] }, "admission": { "const": "mechanical-after-all-predicates" }, "recovery_class": { "enum": ["R-exact", "R-forward"] }, "bounds": { "$ref": "#/$defs/bounds" }, "identities": { "$ref": "#/$defs/identities" }, "required_postconditions": { "$ref": "#/$defs/postconditions" }, "fault_injection_requirements": { "$ref": "#/$defs/fault-injection" } } },
    "micro-routing": { "allOf": [{ "$ref": "#/$defs/class-common" }, { "type": "object", "properties": { "class": { "const": "micro-routing" }, "level": { "const": "L5" }, "owner": { "const": "gille-inference" }, "recovery_class": { "const": "R-exact" } } }] },
    "macro-routing": { "allOf": [{ "$ref": "#/$defs/class-common" }, { "type": "object", "properties": { "class": { "const": "macro-routing" }, "level": { "const": "L5" }, "owner": { "const": "hugin" }, "recovery_class": { "const": "R-exact" } } }] },
    "prompt": { "allOf": [{ "$ref": "#/$defs/class-common" }, { "type": "object", "properties": { "class": { "const": "prompt" }, "level": { "const": "L5" }, "owner": { "const": "hugin" }, "recovery_class": { "const": "R-exact" } } }] },
    "harness": { "allOf": [{ "$ref": "#/$defs/class-common" }, { "type": "object", "properties": { "class": { "const": "harness" }, "level": { "const": "L5" }, "owner": { "const": "hugin" }, "recovery_class": { "const": "R-exact" } } }] },
    "tool-policy": { "allOf": [{ "$ref": "#/$defs/class-common" }, { "type": "object", "properties": { "class": { "const": "tool-policy" }, "level": { "const": "L5" }, "owner": { "const": "hugin" }, "recovery_class": { "const": "R-exact" } } }] },
    "served-model-roster": { "allOf": [{ "$ref": "#/$defs/class-common" }, { "type": "object", "properties": { "class": { "const": "served-model-roster" }, "level": { "const": "L5" }, "owner": { "const": "gille-inference" }, "recovery_class": { "const": "R-exact" } } }] },
    "maintenance": { "allOf": [{ "$ref": "#/$defs/class-common" }, { "type": "object", "properties": { "class": { "const": "no-reboot-security-bugfix-maintenance" }, "level": { "const": "L4" }, "owner": { "const": "brokkr" }, "recovery_class": { "const": "R-forward" } } }] }
  }
}
