{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimnir.gille.ai/contracts/physical-agent-control/profile/v1/schema.json",
  "title": "Grimnir physical agent control profile v1",
  "description": "Owner-reviewed local control bindings. The profile digest is SHA-256 over RFC 8785 canonical bytes of this object with profile_digest omitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "profile_id",
    "profile_version",
    "digest_algorithm",
    "profile_digest",
    "bindings"
  ],
  "properties": {
    "kind": { "const": "physical-control-profile" },
    "schema_version": { "const": "v1" },
    "profile_id": { "$ref": "#/$defs/id" },
    "profile_version": { "$ref": "#/$defs/version" },
    "digest_algorithm": { "const": "profile-jcs-sha256-v1" },
    "profile_digest": { "$ref": "#/$defs/digest" },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/binding" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^v[1-9][0-9]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness", "session_ref", "ownership"],
      "properties": {
        "harness": { "enum": ["codex", "claude-code", "pi"] },
        "session_ref": { "$ref": "#/$defs/id" },
        "ownership": { "enum": ["adapter-owned", "adapter-observed"] }
      }
    },
    "stream-deck-selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "transport", "control", "gesture"],
      "properties": {
        "device": { "const": "stream-deck" },
        "transport": { "const": "stream-deck-sdk" },
        "control": {
          "type": "string",
          "pattern": "^(key|dial)-[a-z0-9-]{1,48}$"
        },
        "gesture": { "enum": ["press", "hold", "double-press"] }
      }
    },
    "tx6-selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "transport", "midi_channel", "cc", "gesture"],
      "properties": {
        "device": { "const": "tx-6" },
        "transport": { "enum": ["usb-midi", "ble-midi"] },
        "midi_channel": { "const": 1 },
        "cc": { "type": "integer", "minimum": 1, "maximum": 37 },
        "gesture": {
          "enum": ["absolute", "relative", "press", "release", "hold"]
        }
      }
    },
    "source-selector": {
      "oneOf": [
        { "$ref": "#/$defs/stream-deck-selector" },
        { "$ref": "#/$defs/tx6-selector" }
      ]
    },
    "simple-action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "enum": [
            "refresh-local-state",
            "open-session",
            "focus-session",
            "set-notification-level",
            "set-effort",
            "set-verbosity",
            "set-display-detail",
            "set-delegation-preference",
            "request-status-turn",
            "request-read-only-review",
            "interrupt",
            "pause"
          ]
        }
      }
    },
    "template-action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "template_id"],
      "properties": {
        "name": { "const": "request-task-template" },
        "template_id": { "$ref": "#/$defs/id" }
      }
    },
    "bound-action": {
      "oneOf": [
        { "$ref": "#/$defs/simple-action" },
        { "$ref": "#/$defs/template-action" }
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "source", "target", "action"],
      "properties": {
        "binding_id": { "$ref": "#/$defs/id" },
        "source": { "$ref": "#/$defs/source-selector" },
        "target": { "$ref": "#/$defs/target" },
        "action": { "$ref": "#/$defs/bound-action" }
      }
    }
  }
}
