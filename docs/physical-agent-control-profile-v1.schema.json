{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimnir.gille.ai/contracts/physical-agent-control/profile/v1/schema.json",
  "title": "Grimnir physical agent console profile v1",
  "description": "Owner-reviewed Stream Deck bindings and local-only EP-2350 capture policy. The profile digest is SHA-256 over RFC 8785 canonical bytes of this object with profile_digest omitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "profile_id",
    "profile_version",
    "digest_algorithm",
    "profile_digest",
    "bindings"
  ],
  "properties": {
    "kind": { "const": "physical-control-profile" },
    "schema_version": { "const": "v1" },
    "profile_id": { "$ref": "#/$defs/id" },
    "profile_version": { "$ref": "#/$defs/version" },
    "digest_algorithm": { "const": "profile-jcs-sha256-v1" },
    "profile_digest": { "$ref": "#/$defs/digest" },
    "voice_capture": { "$ref": "#/$defs/voice-capture" },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/binding" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^v[1-9][0-9]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness", "session_ref", "ownership"],
      "properties": {
        "harness": { "enum": ["codex", "claude-code", "pi"] },
        "session_ref": { "$ref": "#/$defs/id" },
        "ownership": { "enum": ["adapter-owned", "adapter-observed"] }
      }
    },
    "stream-deck-selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "transport", "control", "gesture"],
      "properties": {
        "device": { "const": "stream-deck" },
        "transport": { "const": "stream-deck-sdk" },
        "control": {
          "type": "string",
          "pattern": "^(key|dial)-[a-z0-9-]{1,48}$"
        },
        "gesture": { "enum": ["press", "release", "hold", "double-press"] }
      }
    },
    "voice-capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_claim",
        "transport",
        "identity_assurance",
        "capture_source_ref",
        "coreaudio_uid_ref",
        "interface_generation_ref",
        "channel_set",
        "activation",
        "transcription_boundary",
        "network_access",
        "stt_engine_ref",
        "stt_engine_version",
        "stt_model_ref",
        "stt_model_version",
        "raw_audio_retention",
        "max_capture_seconds",
        "transcript_retention_seconds",
        "sample_token_mode",
        "effect_semantics"
      ],
      "properties": {
        "device_claim": { "const": "ep-2350-ting" },
        "transport": { "const": "analog-line-out-via-audio-interface" },
        "identity_assurance": { "const": "operator-configured" },
        "capture_source_ref": { "$ref": "#/$defs/id" },
        "coreaudio_uid_ref": { "$ref": "#/$defs/id" },
        "interface_generation_ref": { "$ref": "#/$defs/id" },
        "channel_set": { "$ref": "#/$defs/id" },
        "activation": { "const": "stream-deck-ptt" },
        "transcription_boundary": { "const": "workstation-local" },
        "network_access": { "const": "disabled" },
        "stt_engine_ref": { "$ref": "#/$defs/id" },
        "stt_engine_version": { "$ref": "#/$defs/version" },
        "stt_model_ref": { "$ref": "#/$defs/id" },
        "stt_model_version": { "$ref": "#/$defs/version" },
        "raw_audio_retention": { "const": "memory-only-delete-after-transcription" },
        "max_capture_seconds": { "type": "integer", "minimum": 1, "maximum": 30 },
        "transcript_retention_seconds": { "type": "integer", "minimum": 1, "maximum": 900 },
        "sample_token_mode": { "const": "disabled" },
        "effect_semantics": { "const": "none" }
      }
    },
    "simple-action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "enum": [
            "refresh-local-state",
            "open-session",
            "focus-session",
            "begin-voice-capture",
            "end-voice-capture",
            "open-voice-draft",
            "discard-voice-draft",
            "request-status-turn",
            "request-read-only-review",
            "interrupt",
            "pause"
          ]
        }
      }
    },
    "template-action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "template_id"],
      "properties": {
        "name": { "const": "request-task-template" },
        "template_id": { "$ref": "#/$defs/id" }
      }
    },
    "bound-action": {
      "oneOf": [
        { "$ref": "#/$defs/simple-action" },
        { "$ref": "#/$defs/template-action" }
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "source", "target", "action"],
      "properties": {
        "binding_id": { "$ref": "#/$defs/id" },
        "source": { "$ref": "#/$defs/stream-deck-selector" },
        "target": { "$ref": "#/$defs/target" },
        "action": { "$ref": "#/$defs/bound-action" }
      }
    }
  }
}
