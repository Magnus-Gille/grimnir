      "source": { "device": "stream-deck", "transport": "stream-deck-sdk", "control": "key-1-1", "gesture": "press" },
      "target": { "harness": "codex", "session_ref": "slot-1", "ownership": "adapter-observed" },
      "action": { "name": "refresh-local-state" }
    },
    {
      "binding_id": "deck-focus-codex",
      "source": { "device": "stream-deck", "transport": "stream-deck-sdk", "control": "key-1-2", "gesture": "press" },
