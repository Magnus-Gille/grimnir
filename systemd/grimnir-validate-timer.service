[Unit]
Description=Grimnir scheduled registry validation — immutable evidence enabled
After=network-online.target munin-memory.service
Wants=network-online.target
RefuseManualStart=yes

[Service]
Type=oneshot
User=magnus
WorkingDirectory=/home/magnus/repos/grimnir
Environment=GRIMNIR_VALIDATION_ORIGIN=timer
ExecStart=/usr/bin/bash scripts/generate-architecture.sh --validate

TimeoutStartSec=120
ProtectSystem=strict
ReadOnlyPaths=/home/magnus/repos
ReadWritePaths=-/home/magnus/repos/grimnir/.deployed-commit
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
PrivateDevices=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
SystemCallArchitectures=native
